{
  "name": "builder",
  "description": "Default agent for every spec except S03. Builds the monorepo, shop, seams, ghost-core, drivers, CLI, Séance Room, and all supporting infrastructure.",
  "resources": [
    "file://.kiro/steering/product.md",
    "file://.kiro/steering/tech.md",
    "file://.kiro/steering/structure.md",
    "file://.kiro/steering/ghost-impatient.md",
    "file://.kiro/steering/ghost-fraudster.md",
    "file://.kiro/steering/ghost-nightowl.md",
    "file://.kiro/steering/ghost-glitch.md"
  ],
  "permissions": {
    "rules": [
      {
        "capability": "fs_read",
        "match": [
          "apps/shop/src/mutants/**",
          "bench/mutant-manifest.json",
          "bench/manifest.sha256",
          "bench/.private/**",
          ".kiro/specs/S03-mutation-engine/**",
          ".kiro/steering/mutants.md"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_write",
        "match": [
          "apps/shop/src/mutants/**",
          "bench/mutant-manifest.json",
          "bench/manifest.sha256",
          "bench/.private/**",
          ".kiro/specs/S03-mutation-engine/**",
          ".kiro/steering/mutants.md"
        ],
        "effect": "deny"
      },
      {
        "capability": "shell",
        "match": [
          "*src/mutants*",
          "*src\\mutants*",
          "*mutant-manifest*",
          "*manifest.sha256*",
          "*bench/.private*",
          "*bench\\.private*",
          "*S03-mutation-engine*",
          "*git show*",
          "*git log -p*",
          "*git diff*"
        ],
        "effect": "deny"
      }
    ]
  },
  "hooks": [
    {
      "name": "protect-mutants-read",
      "trigger": "PreToolUse",
      "matcher": "read",
      "action": {
        "type": "command",
        "command": "node scripts/protect-mutants.mjs"
      }
    },
    {
      "name": "protect-mutants-write",
      "trigger": "PreToolUse",
      "matcher": "write",
      "action": {
        "type": "command",
        "command": "node scripts/protect-mutants.mjs"
      }
    },
    {
      "name": "protect-mutants-shell",
      "trigger": "PreToolUse",
      "matcher": "shell",
      "action": {
        "type": "command",
        "command": "node scripts/protect-mutants.mjs"
      }
    }
  ]
}
